# WORKS 앱 공개 환경 변수
# Vite는 VITE_ 접두사 변수만 클라이언트 번들에 주입합니다. 서버 시크릿은 절대 여기에 두지 않습니다.
# 실제 값은 .env.local 에 작성하며 커밋하지 않습니다. (root .gitignore가 .env* 제외)

# Supabase 공개 접속 정보 (anon key는 RLS로 보호되는 공개 키)
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="<local-anon-key: `pnpm db:status`로 확인>"

# 앱 실행 환경 (local | development | production)
VITE_APP_ENV="local"

# ── 바깥에 뿌리는 주소의 오리진(공개 전용 도메인)
# WORKS가 담당자에게 보여 주고 복사하게 하는 주소이지, 이 앱이 여는 화면이 아닙니다.
# 두 값 모두 **GUEST 앱 배포**를 가리키며, 비워 두면 WORKS 자신의 오리진으로 떨어지므로
# 운영 배포에서는 반드시 채웁니다.
#
# 도메인을 가르는 이유는 클릭입니다 — 밖에 뿌리는 주소에 `guest`가 붙어 있으면 받는 사람이
# "계정이 있어야 하나"로 읽고 누르지 않습니다. 같은 GUEST 배포에 도메인 별칭 하나를 더 붙일
# 뿐이며 앱 코드는 손대지 않습니다(3_4_15 §5.3.1).
#
# 값을 바꾸면 **그때부터 새로 만드는 주소만** 새 도메인으로 나가고, 이미 배포된 주소는 토큰이
# 같으므로 두 도메인 모두에서 그대로 열립니다 — 기존 링크가 죽지 않습니다.
# 도메인을 붙이는 날 Edge Function의 ALLOWED_ORIGINS에 **같은 건으로** 등록하세요.
VITE_PUBLIC_MODULE_BASE_URL=""   # 예: https://open.example.com/p     (모듈 공개 링크)
VITE_APPLY_BASE_URL=""           # 예: https://open.example.com/apply (모집 신청)
