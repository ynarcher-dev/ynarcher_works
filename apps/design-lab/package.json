{
  "name": "@ynarcher/design-lab",
  "version": "0.0.0",
  "private": true,
  "description": "디자인 견본(살아있는 스타일 가이드) — 실제 @ynarcher/ui 와 tailwind-preset 토큰을 그대로 렌더한다. 배포 대상 아님.",
  "type": "module",
  "scripts": {
    "dev": "vite",
