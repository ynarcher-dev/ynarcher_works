{
  // Edge Function 트리의 타입 점검 전용 설정.
  //
  // 원격 import(`https://esm.sh/...`)는 tsc가 풀지 못하므로 설치된 같은 패키지의 타입으로
  // 이어 준다(types/deno-remote.d.ts). 타입만 빌리는 것이라 런타임과 무관하다.
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@supabase/supabase-js": ["./apps/works/node_modules/@supabase/supabase-js/dist/index.d.mts"],
      "https://esm.sh/@supabase/supabase-js@2": ["./apps/works/node_modules/@supabase/supabase-js/dist/index.d.mts"]
    }
  },
  // 테스트는 vitest 전역·모킹을 쓰므로 이 설정의 대상이 아니다.
  "exclude": ["**/*.test.ts"],
  // 함수 트리 전체를 본다. 예전에는 트리를 하나씩 손으로 적었는데, 목록에서 빠진 함수는
  // 검사되지 않는다는 사실이 어디에도 드러나지 않았다 — 실제로 여러 함수가 한동안 목록
  // 밖에 있었다. 새 함수가 자동으로 포함되도록 글로브로 바꾼다.
  "include": ["types/deno-remote.d.ts", "supabase/functions/**/*.ts"]
}
