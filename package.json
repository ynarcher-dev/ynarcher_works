{
  "name": "ynarcher-works",
  "version": "0.0.0",
  "private": true,
  "description": "와이앤아처 통합 Works 플랫폼 모노레포 (내부 WORKS 앱 + 외부 GUEST 앱)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:baseline",
    "test:db": "node scripts/db-test/run-db-tests.mjs",
    "clean": "turbo run clean",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:migration": "supabase migration new",
    "db:baseline:refresh": "node scripts/db-baseline/refresh.mjs",
    "db:baseline:check": "node scripts/db-baseline/check.mjs",
    "db:baseline:verify": "node scripts/db-baseline/check.mjs --full",
    "test:baseline": "node --test \"scripts/db-baseline/*.node-test.mjs\"",
    "functions:serve": "supabase functions serve",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "supabase": "^2.109.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
